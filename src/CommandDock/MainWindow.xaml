<Window x:Class="CommandDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vo="clr-namespace:CommandDock.Domain.ValueObjects;assembly=CommandDock.Domain"
        Title="CommandDock" Height="600" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewCommandCommand}" />
        <KeyBinding Modifiers="Control" Key="E" Command="{Binding EditCommandCommand}" />
        <KeyBinding Modifiers="Control" Key="Return" Command="{Binding RunCommandCommand}" />
        <KeyBinding Modifiers="Control" Key="OemPeriod" Command="{Binding StopCommand}" />
        <KeyBinding Modifiers="Control" Key="L" Command="{Binding ClearOutputCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left pane: command list -->
        <Border Grid.Column="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Commands" FontSize="14" FontWeight="SemiBold" Margin="12,12,12,8" />

                <Grid Grid.Row="1" Margin="12,0,12,8">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4"
                             Background="{DynamicResource PanelBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             CaretBrush="{DynamicResource ForegroundBrush}"
                             PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    <TextBlock Text="Search... (Ctrl+F)"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource MutedBrush}"
                               Opacity="0.5"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ListBox Grid.Row="2"
                         x:Name="CommandsList"
                         ItemsSource="{Binding CommandsView}"
                         SelectedItem="{Binding SelectedCommand, Mode=TwoWay}"
                         Background="Transparent"
                         Foreground="{DynamicResource ForegroundBrush}"
                         BorderThickness="0"
                         Margin="4,0,4,0"
                         HorizontalContentAlignment="Stretch"
                         MouseDoubleClick="CommandsList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Icon, Converter={StaticResource IconWithFallback}}"
                                           FontSize="16"
                                           Width="24"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="2,0,4,0" />
                                <StackPanel Grid.Column="1" Margin="6,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Content="⋮"
                                        Click="ItemMoreButton_Click"
                                        Tag="{Binding DataContext, ElementName=CommandsList}"
                                        Width="24" Height="24"
                                        Padding="0" Margin="0,0,4,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource MutedBrush}"
                                        FontSize="16" FontWeight="Bold"
                                        Cursor="Hand"
                                        ToolTip="More actions"
                                        VerticalAlignment="Center">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Edit"
                                                      Command="{Binding PlacementTarget.Tag.EditCommandCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Delete"
                                                      Command="{Binding PlacementTarget.Tag.DeleteCommandCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="12">
                    <Button Content="New" Command="{Binding NewCommandCommand}" ToolTip="Ctrl+N" />
                </StackPanel>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="5"
                      Background="{DynamicResource BorderBrush}"
                      HorizontalAlignment="Stretch" />

        <!-- Right pane: details + output -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: name + description -->
            <StackPanel Grid.Row="0" Margin="16,12,16,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectedCommand.Icon, Converter={StaticResource IconWithFallback}, FallbackValue=''}"
                               FontSize="20"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="{Binding SelectedCommand.Name, FallbackValue='Select a command'}"
                               FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding SelectedCommand.Description}"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Command preview + actions -->
            <Border Grid.Row="1" Margin="16,4,16,8"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0"
                             Text="{Binding SelectedCommand.CommandText, Mode=OneWay, FallbackValue=''}"
                             IsReadOnly="True"
                             Background="Transparent"
                             Foreground="{DynamicResource CodePreviewBrush}"
                             BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="13"
                             Margin="10,8"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MaxHeight="120"
                             VerticalScrollBarVisibility="Auto" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,4,10,8">
                        <Button Content="▶ Run" Command="{Binding RunCommandCommand}"
                                ToolTip="Ctrl+Enter"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource AccentForegroundBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" />
                        <Button Content="■ Stop" Command="{Binding StopCommand}" ToolTip="Ctrl+." />
                        <Button Content="Clear output" Command="{Binding ClearOutputCommand}" ToolTip="Ctrl+L" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Output console -->
            <Border Grid.Row="2" Margin="16,0,16,8"
                    Background="{DynamicResource ConsoleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <ScrollViewer x:Name="OutputScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Output}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="12"
                                           Padding="10,0"
                                           TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource StdoutBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Stream}" Value="{x:Static vo:OutputStream.Stderr}">
                                                    <Setter Property="Foreground" Value="{DynamicResource StderrBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="3"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="16,6">
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource MutedBrush}" />
            </Border>
        </Grid>
    </Grid>
</Window>
