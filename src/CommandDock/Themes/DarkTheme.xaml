<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="PanelBrush" Color="#252526" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3C3C3C" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0E639C" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#888888" />
    <SolidColorBrush x:Key="StdoutBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="StderrBrush" Color="#F48771" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#2D2D30" />
    <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#0D0D0D" />
    <SolidColorBrush x:Key="CodePreviewBrush" Color="#D4D4D4" />

</ResourceDictionary>
